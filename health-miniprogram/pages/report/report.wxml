<!--pages/report/report.wxml-->
<view class="container">
  <view class="header">
    <button class="generate-btn" bindtap="generateReport">
      <text class="icon">+</text>
      生成报告
    </button>
  </view>

  <view class="report-list" wx:if="{{reports.length > 0}}">
    <view class="report-item" wx:for="{{reports}}" wx:key="id">
      <view class="report-header" bindtap="viewReport" data-item="{{item}}">
        <view class="report-info">
          <text class="report-type">{{item.report_type === 'daily' ? '日报' : item.report_type === 'weekly' ? '周报' : '月报'}}</text>
          <text class="report-period">{{item.report_period}}</text>
        </view>
        <view class="report-status">
          <text class="status-dot"></text>
          <text>已完成</text>
        </view>
      </view>
      <view class="report-footer">
        <text class="report-date">{{item.generated_at}}</text>
        <view class="actions">
          <text class="action-btn" bindtap="viewReport" data-item="{{item}}">查看</text>
          <text class="action-btn delete" bindtap="deleteReport" data-item="{{item}}" data-index="{{index}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <image class="empty-icon" src="/images/empty.png" mode="aspectFit" />
    <text class="empty-text">暂无报告</text>
    <text class="empty-tip">点击上方按钮生成您的第一份报告</text>
  </view>
</view>
