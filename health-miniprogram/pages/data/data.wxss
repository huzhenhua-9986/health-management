/* pages/data/data.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.tabs {
  display: flex;
  background: white;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #667eea;
  border-radius: 2rpx;
}

.content {
  padding: 20rpx;
}

.data-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.data-item {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.data-content {
  padding: 24rpx;
}

.delete-btn {
  padding: 20rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #f56c6c;
  border-top: 1px solid #f0f0f0;
}

.data-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.data-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.data-date {
  font-size: 24rpx;
  color: #999;
}

.data-value {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.data-value .value {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
}

.data-value .unit {
  font-size: 24rpx;
  color: #999;
}

.data-source {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

.exercise-grid, .sleep-grid {
  display: flex;
  gap: 20rpx;
}

.grid-item {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.grid-item .label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.grid-item .value {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.diet-info {
  display: flex;
  gap: 40rpx;
}

.info-item {
  display: flex;
  gap: 12rpx;
}

.info-item .label {
  font-size: 24rpx;
  color: #999;
}

.info-item .value {
  font-size: 26rpx;
  color: #333;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}
