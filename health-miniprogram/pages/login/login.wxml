<!--pages/login/login.wxml-->
<view class="container">
  <view class="logo">
    <image src="/images/logo.png" class="logo-img" mode="aspectFit" />
    <text class="app-name">健康管理系统</text>
  </view>

  <view class="login-box">
    <view class="input-group">
      <input
        class="input"
        type="number"
        placeholder="请输入手机号"
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-group code-group">
      <input
        class="input"
        type="number"
        placeholder="请输入验证码"
        maxlength="6"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <button
        class="code-btn"
        bindtap="getCode"
        disabled="{{!canGetCode}}"
      >
        {{canGetCode ? '获取验证码' : countdown + 's'}}
      </button>
    </view>

    <button class="login-btn" bindtap="codeLogin">登录</button>

    <view class="divider">
      <text class="divider-text">或</text>
    </view>

    <button class="wx-login-btn" open-type="getUserInfo" bindgetuserinfo="wxLogin">
      <image src="/images/wechat.png" class="wx-icon" />
      微信一键登录
    </button>
  </view>

  <view class="agreement">
    登录即表示同意
    <text class="link">《用户协议》</text>
    和
    <text class="link">《隐私政策》</text>
  </view>
</view>
