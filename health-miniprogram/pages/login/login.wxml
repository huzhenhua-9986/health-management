<!--pages/login/login.wxml-->
<view class="container">
  <view class="logo">
    <image src="/images/logo.png" class="logo-img" mode="aspectFit" />
    <text class="app-name">健康管理系统</text>
    <text class="app-slogan">健康每一天，从记录开始</text>
  </view>

  <view class="login-box">
    <!-- 微信一键登录 -->
    <button
      class="wx-login-btn"
      open-type="{{loading ? '' : 'getUserInfo'}}"
      bindgetuserinfo="wxLogin"
      disabled="{{loading}}"
    >
      <text class="wx-icon">💬</text>
      微信一键登录
    </button>

    <!-- 手机号快捷登录 -->
    <button
      class="phone-login-btn"
      open-type="{{loading ? '' : 'getPhoneNumber'}}"
      bindgetphonenumber="wxLogin"
      disabled="{{loading}}"
    >
      <text class="phone-icon">📱</text>
      手机号快捷登录
    </button>

    <view class="divider">
      <view class="line"></view>
      <text class="divider-text">或</text>
      <view class="line"></view>
    </view>

    <!-- 验证码登录 -->
    <view class="input-group">
      <input
        class="input"
        type="number"
        placeholder="请输入手机号"
        maxlength="11"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>

    <view class="input-group code-group">
      <input
        class="input code-input"
        type="number"
        placeholder="请输入验证码"
        maxlength="6"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <button
        class="code-btn"
        bindtap="getCode"
        disabled="{{!canGetCode}}"
      >
        {{canGetCode ? '获取验证码' : countdown + 's'}}
      </button>
    </view>

    <button class="login-btn" bindtap="codeLogin" disabled="{{loading}}">登录</button>

    <!-- 快速体验（开发用） -->
    <view class="quick-login">
      <text class="link" bindtap="quickLogin">快速体验</text>
    </view>
  </view>

  <view class="agreement">
    登录即表示同意
    <text class="link">《用户协议》</text>
    和
    <text class="link">《隐私政策》</text>
  </view>
</view>
