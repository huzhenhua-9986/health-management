/* pages/login/login.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 100rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logo {
  text-align: center;
  margin-bottom: 80rpx;
}

.logo-img {
  width: 160rpx;
  height: 160rpx;
  background: white;
  border-radius: 32rpx;
  margin-bottom: 20rpx;
}

.app-name {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

.app-slogan {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.login-box {
  width: 100%;
  background: white;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
}

/* 微信登录按钮 */
.wx-login-btn, .phone-login-btn {
  width: 100%;
  height: 88rpx;
  background: #07c160;
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 20rpx;
}

.phone-login-btn {
  background: #667eea;
}

.wx-login-btn[disabled], .phone-login-btn[disabled] {
  opacity: 0.6;
}

.wx-icon, .phone-icon {
  font-size: 32rpx;
}

/* 分隔线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.line {
  flex: 1;
  height: 1px;
  background: #eee;
}

.divider-text {
  padding: 0 20rpx;
  color: #999;
  font-size: 24rpx;
}

/* 输入框 */
.input-group {
  margin-bottom: 30rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.code-group {
  display: flex;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.code-btn {
  flex-shrink: 0;
  width: 200rpx;
  height: 88rpx;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 24rpx;
  line-height: 88rpx;
  padding: 0;
}

.code-btn[disabled] {
  background: #ccc;
}

.login-btn {
  width: 100%;
  height: 88rpx;
  background: #667eea;
  color: white;
  border: none;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 20rpx;
}

.login-btn[disabled] {
  background: #ccc;
}

/* 快速登录 */
.quick-login {
  text-align: center;
  margin-top: 30rpx;
}

.quick-login .link {
  font-size: 24rpx;
  color: #667eea;
}

/* 协议 */
.agreement {
  margin-top: 40rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  text-align: center;
}

.agreement .link {
  color: white;
  text-decoration: underline;
}
